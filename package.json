{
  "name": "juridico-replit",
  "version": "1.0.5",
  "description": "Assistente IA Jurídico (versão do Replit)",
  "author": "Maikon",
  "private": true,
  "main": "electron/main.cjs",
  "portaDoPrograma": 7740,
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.maikon.juridico.replit",
    "productName": "Juridico Replit",
    "executableName": "Juridico-Replit",
    "directories": { "output": "release" },
    "asar": false,
    "files": ["electron/**", "www/**", "package.json"],
    "win": { "target": ["portable"], "icon": "www/icon-512.png" },
    "portable": { "artifactName": "Juridico-Replit.exe" }
  }
}
